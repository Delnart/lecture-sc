# ======================================================
# Токен бота від @BotFather
# ======================================================
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ======================================================
# Neon PostgreSQL — рядок підключення
#
# Формат: postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/dbname?ssl=require
#
# ⚠️  ВАЖЛИВО:
#   - Використовуй рядок з пулером з'єднань Neon (Pooler connection string)
#     замість прямого підключення — він знаходиться на порту 5432,
#     тоді як прямий — на 5432 теж, але endpoint інший.
#     У Neon Console → Connection Details → обери "Pooler".
#   - ?ssl=require обов'язковий
# ======================================================
BD_ENGINE=postgresql+asyncpg://user:password@ep-xxx-yyy.us-east-2.aws.neon.tech/dbname?ssl=require

# ======================================================
# Telegram ID адмінів через кому (без пробілів)
# ======================================================
SUPER_ADMINS=123456789,987654321

# ======================================================
# Google Sheets
# Назва файлу таблиці (саме ім'я, не URL)
# ======================================================
LOG_SHEET_NAME=Лекція Студрада ФІОТ 2026

# URL таблиці (для кнопки в адмін-панелі)
SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID

# ======================================================
# Google Service Account credentials
#
# На Render: відкрий credentials.json, скопіюй весь вміст
# і встав його як значення цієї змінної (Render підтримує multiline).
#
# Для локальної розробки: просто поклади credentials.json в app/data/
# і цю змінну можна не вказувати.
# ======================================================
GOOGLE_CREDENTIALS_JSON=
